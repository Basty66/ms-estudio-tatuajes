# --- Base de datos (Neon PostgreSQL) ---
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Panel admin ---
# Usa una contraseña LARGA y aleatoria (no "admin123").
ADMIN_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio

# Secret para firmar los JWT de sesión admin.
# Genéralo con: openssl rand -base64 48
JWT_SECRET=genera-uno-con-openssl-rand-base64-48

# --- Notificaciones Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
