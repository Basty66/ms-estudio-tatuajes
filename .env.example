# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio: los valores reales viven ahí y en Vercel.

# --- Base de datos (Neon, endpoint -pooler) ---
# En desarrollo, la rama dev. La de producción va aparte y solo la usa
# scripts/migrar.mjs --produccion y scripts/variables-vercel.mjs production.
NEON_DATABASE_URL=
NEON_DATABASE_URL_PRODUCCION=

# --- Panel (/tinta) ---
# Clave que se pide una vez por aparato. Larga y aleatoria.
ADMIN_CLAVE=

# --- Avisos push (genera las llaves con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=

# --- Aviso diario (cron de Vercel) ---
CRON_SECRET=

# --- Archivos (Vercel Blob) ---
# Público: fotos de la galería. Privado: comprobantes de pago.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVADO_READ_WRITE_TOKEN=
